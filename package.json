{
  "name": "quantum-sentinel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "test:integration": "pnpm db:up && vitest run -c vitest.integration.config.ts",
    "sandbox": "pnpm --silent --filter @sentinel/api exec tsx --env-file-if-exists=../../.env src/cli/sandbox.ts",
    "api": "pnpm --filter @sentinel/api dev",
    "audit:verify": "pnpm --silent --filter @sentinel/api exec tsx --env-file-if-exists=../../.env src/cli/ops.ts audit:verify",
    "reconcile": "pnpm --silent --filter @sentinel/api exec tsx --env-file-if-exists=../../.env src/cli/ops.ts reconcile",
    "investigate": "pnpm --silent --filter @sentinel/api exec tsx --env-file-if-exists=../../.env src/cli/investigate.ts",
    "seed:demo": "pnpm --silent --filter @sentinel/api exec tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "web": "pnpm --filter @sentinel/web dev",
    "build:web": "pnpm --filter @sentinel/web build",
    "up": "docker compose up --build",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
