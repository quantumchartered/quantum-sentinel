# Copy to .env in the project root. Never put credentials in chat or Git.
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Candidate pin from current official docs; validate account/webhook contract in Phase 1.
AIRWALLEX_API_VERSION=2026-08-21
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# Select a supported Claude model against the account in Phase 2.
ANTHROPIC_MODEL=
# Generate independent random local secrets during implementation.
APPROVAL_HMAC_SECRET=
SESSION_SECRET=
# Local Postgres from docker-compose.yml (127.0.0.1:54329, never :5432).
POSTGRES_PASSWORD=sentinel_local_dev
DATABASE_URL=postgres://sentinel:sentinel_local_dev@127.0.0.1:54329/sentinel
