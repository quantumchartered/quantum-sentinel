# Copy to .env in the project root. Never put credentials in chat or Git.
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Candidate pin from current official docs; confirmed against the account in the T0 feasibility run.
AIRWALLEX_API_VERSION=2026-08-21
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# Needed from T3a (agent). Model is configurable.
ANTHROPIC_MODEL=
# Independent random secrets, generated in T2. Never reuse the Airwallex key.
APPROVAL_HMAC_SECRET=
SESSION_SECRET=
# Local Postgres from docker-compose.yml (127.0.0.1:54329, never :5432).
POSTGRES_PASSWORD=sentinel_local_dev
DATABASE_URL=postgres://sentinel:sentinel_local_dev@127.0.0.1:54329/sentinel
# Tenant for the single-org sandbox demo: `pnpm sandbox seed-org` prints one if empty.
SENTINEL_ORGANIZATION_ID=
# Filled in after `pnpm sandbox beneficiary` / `pnpm sandbox transfer` (optional convenience).
SENTINEL_BENEFICIARY_ID=
SENTINEL_TRANSFER_ID=
PORT=4000
POLL_INTERVAL_MS=15000
